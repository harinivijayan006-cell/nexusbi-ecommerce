# Application Port
PORT=3000

# Cloud SQL PostgreSQL Database Variables (Injected automatically at runtime)
SQL_HOST="cloudsql_instance_proxy_socket"
SQL_USER="postgres_user"
SQL_PASSWORD="postgres_password"
SQL_DB_NAME="postgres_database"

# Schema Management Admin Credentials (drizzle-kit)
SQL_ADMIN_USER="postgres_admin"
SQL_ADMIN_PASSWORD="postgres_admin_password"

# Gemini API Key (optional AI features)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public App URL
APP_URL="MY_APP_URL"
